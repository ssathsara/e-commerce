# Base path of the API. Keep it relative so requests go through the dev proxy
# (or the production reverse proxy) and stay same-origin for Sanctum cookies.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api, /sanctum and /storage.
VITE_API_PROXY_TARGET=http://localhost:8000

VITE_APP_NAME=ShopSphere
