APP_NAME="ShopSphere"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# URL of the React storefront. Used for password-reset / email-verification links.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=root
DB_PASSWORD=

# Sanctum SPA (cookie) authentication.
# Hosts (with port) the browser SPA is served from. Requests from these origins get session auth + CSRF.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8080
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
# Set to true in production (HTTPS only).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Comma separated list of origins allowed by CORS (only needed when the SPA is on another origin).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. "log" writes emails to storage/logs for local development.
# Configure a real SMTP server via environment variables in production. Never commit credentials.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@shopsphere.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Shop business configuration (see config/shop.php) ---
SHOP_CURRENCY=USD
# Percentage applied to (subtotal - discount). 0 disables tax.
SHOP_TAX_RATE=8
# Orders at or above this amount (major units) ship free with the standard method.
SHOP_FREE_SHIPPING_THRESHOLD=100
SHOP_STANDARD_SHIPPING=5.99
SHOP_EXPRESS_SHIPPING=14.99
# When true, customers may only review products from a delivered order.
SHOP_REVIEWS_REQUIRE_PURCHASE=true
# When true, new reviews must be approved by a moderator before being public.
SHOP_REVIEWS_REQUIRE_APPROVAL=true

# Payment gateway used for card payments. Only "mock" ships with the project.
PAYMENT_GATEWAY=mock
